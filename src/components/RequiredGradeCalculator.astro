---
import { formatNumber, projectedFinalGrade, requiredGrade, minimumRequiredGrade, roundHalfUp } from '../lib/calculators/core';
const initialRequired=requiredGrade({currentAverage:5,completedWeight:70,finalWeight:30,targetGrade:5.4});
const initialScenarios=[4,5,6,7].map(exam=>({
  exam,
  projected:projectedFinalGrade({currentAverage:5,completedWeight:70,finalGrade:exam,finalWeight:30})
}));
---
<div class="tool-shell">
  <div class="tool-head">
    <div>
      <h2>¿Qué nota necesito?</h2>
      <p>Calcula la nota mínima necesaria y compara distintos escenarios de examen.</p>
    </div>
    <span class="badge">Cálculo inverso</span>
  </div>
  <div class="tool-grid">
    <form class="tool-panel" id="r-form">
      <div class="field">
        <label for="r-current">Promedio actual</label>
        <input class="input" id="r-current" value="5,0" inputmode="decimal" />
      </div>
      <div class="inline-fields">
        <div class="field">
          <label for="r-completed">Porcentaje completado</label>
          <input class="input" id="r-completed" value="70" inputmode="decimal" />
        </div>
        <div class="field">
          <label for="r-finalweight">Peso de la evaluación final</label>
          <input class="input" id="r-finalweight" value="30" inputmode="decimal" />
        </div>
      </div>
      <div class="field">
        <label for="r-target">Nota final deseada</label>
        <input class="input" id="r-target" value="5,4" inputmode="decimal" />
      </div>
      <div class="actions">
        <button class="btn btn-primary" type="submit">Calcular nota necesaria</button>
        <button class="btn btn-secondary" type="button" id="r-share">Compartir cálculo</button>
        <button class="btn btn-ghost" type="button" id="r-reset">Restablecer</button>
      </div>
    <p id="r-share-status" class="muted" aria-live="polite"></p>
    </form>

    <div class="tool-panel result-panel">
      <div class="result-card" aria-live="polite">
        <div class="result-label">Necesitas</div>
        <div class="result-value" id="r-result">{formatNumber(minimumRequiredGrade(initialRequired,1),1)}</div>
        <div class="result-meta result-meta-three">
          <div class="result-stat">
            <span class="result-stat-label">Objetivo</span>
            <strong id="r-target-summary">5,4</strong>
          </div>
          <div class="result-stat">
            <span class="result-stat-label">Calculado (3 decimales)</span>
            <strong id="r-exact">{formatNumber(initialRequired,3)}</strong>
          </div>
          <div class="result-stat">
            <span class="result-stat-label">Factibilidad</span>
            <strong id="r-feasibility">Alcanzable</strong>
          </div>
        </div>
        <p id="r-message" style="margin:16px 0 0;color:#b9c5d9;font-size:.88rem">Mínimo a un decimal, redondeado hacia arriba para alcanzar el objetivo sin redondear la nota final.</p>
        <p id="r-range" style="margin:6px 0 0;color:#9eacc3;font-size:.8rem">Rango final posible: 3,8–5,6</p>
      </div>
      <p id="r-error" class="muted" aria-live="polite"></p>
    </div>
  </div>

  <div class="tool-panel scenario-panel">
    <div class="scenario-head">
      <div>
        <span class="scenario-kicker">Simulador rápido</span>
        <h3>Si sacas esta nota, tu final quedaría en…</h3>
      </div>
      <span class="muted">Escala de referencia 1,0–7,0</span>
    </div>
    <div class="table-wrap" tabindex="0" role="region" aria-label="Tabla con desplazamiento horizontal">
      <table class="data-table">
        <caption class="sr-only">Escenarios de nota de examen y nota final proyectada.</caption>
        <thead><tr><th>Nota examen</th><th>Nota final proyectada</th></tr></thead>
        <tbody id="r-scenarios">
          {initialScenarios.map(row=><tr><td>{formatNumber(row.exam,1)}</td><td><strong>{formatNumber(roundHalfUp(row.projected,2),2)}</strong></td></tr>)}
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  import { shareOrCopy } from '../lib/browser/share';
  import { formatNumber, parseDecimal, projectedFinalGrade, requiredGrade, minimumRequiredGrade, roundHalfUp } from '../lib/calculators/core';

  function readHash(){
    const params=new URLSearchParams(window.location.hash.replace(/^#/,''));
    const mapping=[
      ['promedio','#r-current'],
      ['completado','#r-completed'],
      ['final','#r-finalweight'],
      ['objetivo','#r-target'],
    ];
    for(const [key,selector] of mapping){
      const value=params.get(key);
      const input=document.querySelector<HTMLInputElement>(selector);
      if(value!==null && input) input.value=value;
    }
  }

  function shareUrl(){
    const params=new URLSearchParams({
      promedio:(document.querySelector<HTMLInputElement>('#r-current')!).value.trim(),
      completado:(document.querySelector<HTMLInputElement>('#r-completed')!).value.trim(),
      final:(document.querySelector<HTMLInputElement>('#r-finalweight')!).value.trim(),
      objetivo:(document.querySelector<HTMLInputElement>('#r-target')!).value.trim(),
    });
    return `${window.location.origin}${window.location.pathname}#${params.toString()}`;
  }

  function calc(){
    const out=document.querySelector<HTMLElement>('#r-result')!;
    const msg=document.querySelector<HTMLElement>('#r-message')!;
    const err=document.querySelector<HTMLElement>('#r-error')!;
    const targetSummary=document.querySelector<HTMLElement>('#r-target-summary')!;
    const exact=document.querySelector<HTMLElement>('#r-exact')!;
    const feasibility=document.querySelector<HTMLElement>('#r-feasibility')!;
    const scenarios=document.querySelector<HTMLElement>('#r-scenarios')!;
    const range=document.querySelector<HTMLElement>('#r-range')!;

    try{
      const currentAverage=parseDecimal((document.querySelector<HTMLInputElement>('#r-current')!).value);
      const completedWeight=parseDecimal((document.querySelector<HTMLInputElement>('#r-completed')!).value);
      const finalWeight=parseDecimal((document.querySelector<HTMLInputElement>('#r-finalweight')!).value);
      const targetGrade=parseDecimal((document.querySelector<HTMLInputElement>('#r-target')!).value);

      const grade=requiredGrade({currentAverage,completedWeight,finalWeight,targetGrade});
      const minFinal=projectedFinalGrade({currentAverage,completedWeight,finalGrade:1,finalWeight});
      const maxFinal=projectedFinalGrade({currentAverage,completedWeight,finalGrade:7,finalWeight});
      exact.textContent=formatNumber(grade,3);
      targetSummary.textContent=formatNumber(targetGrade,1);
      range.textContent=`Rango final posible: ${formatNumber(roundHalfUp(minFinal,2),2)}–${formatNumber(roundHalfUp(maxFinal,2),2)}`;

      if(grade>7){
        out.textContent='> 7,0';
        feasibility.textContent='No alcanzable';
        msg.textContent='Con una escala máxima de 7,0, este objetivo no es alcanzable con el peso restante.';
      }else if(grade<1){
        out.textContent='≤ 1,0';
        feasibility.textContent='Objetivo cubierto';
        msg.textContent='Tu objetivo ya está cubierto matemáticamente con una nota mínima.';
      }else{
        out.textContent=formatNumber(minimumRequiredGrade(grade,1),1);
        feasibility.textContent='Alcanzable';
        msg.textContent='Mínimo a un decimal, redondeado hacia arriba para alcanzar el objetivo sin redondear la nota final.';
      }

      const scenarioGrades=[4,5,6,7];
      scenarios.innerHTML=scenarioGrades.map(exam=>{
        const projected=projectedFinalGrade({currentAverage,completedWeight,finalGrade:exam,finalWeight});
        return `<tr><td>${formatNumber(exam,1)}</td><td><strong>${formatNumber(roundHalfUp(projected,2),2)}</strong></td></tr>`;
      }).join('');
      err.textContent='';
    }catch(e){
      out.textContent='—';
      targetSummary.textContent='—';
      exact.textContent='—';
      feasibility.textContent='—';
      msg.textContent='Revisa los porcentajes y las notas.';
      scenarios.innerHTML='';
      range.textContent='';
      err.textContent=e instanceof Error?e.message:'Revisa los datos.';
    }
  }

  document.querySelector('#r-form')?.addEventListener('submit',e=>{e.preventDefault();calc()});
  document.querySelector('#r-form')?.addEventListener('input',calc);

  document.querySelector('#r-share')?.addEventListener('click',async()=>{
    const shareStatus=document.querySelector<HTMLElement>('#r-share-status')!;
    const currentAverage=parseDecimal((document.querySelector<HTMLInputElement>('#r-current')!).value);
    const completedWeight=parseDecimal((document.querySelector<HTMLInputElement>('#r-completed')!).value);
    const finalWeight=parseDecimal((document.querySelector<HTMLInputElement>('#r-finalweight')!).value);
    const targetGrade=parseDecimal((document.querySelector<HTMLInputElement>('#r-target')!).value);
    try{
      requiredGrade({currentAverage,completedWeight,finalWeight,targetGrade});
    }catch{
      shareStatus.textContent='Corrige los datos antes de compartir.';
      return;
    }
    const url=shareUrl();
    const shareResult=await shareOrCopy('¿Qué nota necesito?',url);
    if(shareResult==='shared') shareStatus.textContent='Cálculo compartido.';
    else if(shareResult==='copied') shareStatus.textContent='Enlace copiado al portapapeles.';
    else if(shareResult==='cancelled') shareStatus.textContent='';
    else shareStatus.textContent='No se pudo compartir. Puedes copiar la URL del navegador como alternativa.';
  });

  document.querySelector('#r-reset')?.addEventListener('click',()=>{
    (document.querySelector<HTMLInputElement>('#r-current')!).value='5,0';
    (document.querySelector<HTMLInputElement>('#r-completed')!).value='70';
    (document.querySelector<HTMLInputElement>('#r-finalweight')!).value='30';
    (document.querySelector<HTMLInputElement>('#r-target')!).value='5,4';
    (document.querySelector<HTMLElement>('#r-share-status')!).textContent='';
    history.replaceState(null,'',window.location.pathname+window.location.search);
    calc();
  });
  window.addEventListener('hashchange',()=>{readHash();calc()});

  readHash();
  calc();
</script>
