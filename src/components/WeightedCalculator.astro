---
import { formatNumber, roundHalfUp, weightedAverage } from '../lib/calculators/core';
const initialItems=[['6,0','20'],['5,5','30'],['4,8','50']];
const initialWeighted=weightedAverage([{grade:6,weight:20},{grade:5.5,weight:30},{grade:4.8,weight:50}]);
---
<div class="tool-shell">
  <div class="tool-head">
    <div>
      <h2>Calculadora de notas con porcentaje</h2>
      <p>Combina notas y ponderaciones para obtener tu promedio ponderado y ver cuánto peso falta.</p>
    </div>
    <span class="badge">Peso visible</span>
  </div>

  <div class="tool-grid">
    <form class="tool-panel" id="w-form">
      <div class="list-editor" id="w-list">
        {initialItems.map((row,index)=>
          <div class="row-editor">
            <div class="field" style="margin:0">
              <label for={`w-grade-${index}`}>Nota {index+1}</label>
              <input class="input w-grade" id={`w-grade-${index}`} data-i={index} value={row[0]} inputmode="decimal" />
            </div>
            <div class="field" style="margin:0">
              <label for={`w-weight-${index}`}>Peso (%)</label>
              <input class="input w-weight" id={`w-weight-${index}`} data-i={index} value={row[1]} inputmode="decimal" />
            </div>
            <button class="icon-btn" type="button" data-remove={index} aria-label={`Eliminar evaluación ${index+1}`} title="Eliminar evaluación">×</button>
          </div>
        )}
      </div>
      <div class="actions">
        <button class="btn btn-secondary" type="button" id="w-add">Agregar evaluación</button>
        <button class="btn btn-primary" type="submit">Calcular ponderación</button>
        <button class="btn btn-secondary" type="button" id="w-share">Compartir cálculo</button>
        <button class="btn btn-ghost" type="button" id="w-reset">Restablecer</button>
      </div>
    <p id="w-share-status" class="muted" aria-live="polite"></p>
    </form>

    <div class="tool-panel result-panel">
      <div class="result-card" aria-live="polite">
        <div class="result-label" id="w-result-label">Promedio ponderado</div>
        <div class="result-value" id="w-result">{formatNumber(roundHalfUp(initialWeighted.average,2),2)}</div>
        <div class="result-meta result-meta-three">
          <div class="result-stat">
            <span class="result-stat-label">Peso utilizado</span>
            <strong id="w-used">{formatNumber(initialWeighted.totalWeight,1)}%</strong>
          </div>
          <div class="result-stat">
            <span class="result-stat-label">Peso restante</span>
            <strong id="w-left">{formatNumber(100-initialWeighted.totalWeight,1)}%</strong>
          </div>
          <div class="result-stat">
            <span class="result-stat-label">Aporte sobre 100%</span>
            <strong id="w-contribution">{formatNumber(roundHalfUp(initialWeighted.contribution,2),2)}</strong>
          </div>
        </div>
        <p id="w-status" style="margin:16px 0 0;color:#b9c5d9;font-size:.88rem">Ponderación completa: los porcentajes suman aproximadamente 100%.</p>
      </div>
      <p id="w-error" class="muted" aria-live="polite"></p>
    </div>
  </div>
</div>

<script>
  import { formatNumber, parseDecimal, roundHalfUp, weightedAverage, weightStatus } from '../lib/calculators/core';

  const list=document.querySelector<HTMLElement>('#w-list')!;
  const shareStatus=document.querySelector<HTMLElement>('#w-share-status')!;
  let items=[['6,0','20'],['5,5','30'],['4,8','50']];

  function readHash(){
    const params=new URLSearchParams(window.location.hash.replace(/^#/,''));
    const raw=params.get('ponderaciones');
    if(!raw) return;
    const parsed=raw.split('|').slice(0,30).map(pair=>{
      const [grade,weight]=pair.split(':');
      return [grade?.trim()||'',weight?.trim()||''];
    }).filter(([grade,weight])=>grade || weight);
    if(parsed.length) items=parsed;
  }

  function shareUrl(){
    const value=items.map(([grade,weight])=>`${grade.trim()}:${weight.trim()}`).join('|');
    const params=new URLSearchParams({ponderaciones:value});
    return `${window.location.origin}${window.location.pathname}${window.location.search}#${params.toString()}`;
  }

  function escapeHTML(value: unknown){
    return String(value)
      .replace(/&/g,'&amp;')
      .replace(/</g,'&lt;')
      .replace(/>/g,'&gt;')
      .replace(/"/g,'&quot;')
      .replace(/'/g,'&#039;');
  }

  function draw(){
    list.innerHTML=items.map((row,i)=>`
      <div class="row-editor">
        <div class="field" style="margin:0">
          <label for="w-grade-${i}">Nota ${i+1}</label>
          <input class="input w-grade" id="w-grade-${i}" data-i="${i}" value="${escapeHTML(row[0])}" inputmode="decimal">
        </div>
        <div class="field" style="margin:0">
          <label for="w-weight-${i}">Peso (%)</label>
          <input class="input w-weight" id="w-weight-${i}" data-i="${i}" value="${escapeHTML(row[1])}" inputmode="decimal">
        </div>
        <button class="icon-btn" type="button" data-remove="${i}" aria-label="Eliminar evaluación ${i+1}" title="Eliminar evaluación">×</button>
      </div>`).join('');

    list.querySelectorAll<HTMLInputElement>('.w-grade').forEach(input=>input.addEventListener('input',()=>{
      items[Number(input.dataset.i)][0]=input.value;
      calc();
    }));
    list.querySelectorAll<HTMLInputElement>('.w-weight').forEach(input=>input.addEventListener('input',()=>{
      items[Number(input.dataset.i)][1]=input.value;
      calc();
    }));
    list.querySelectorAll<HTMLButtonElement>('[data-remove]').forEach(button=>button.addEventListener('click',()=>{
      items.splice(Number(button.dataset.remove),1);
      if(!items.length) items=[['','']];
      draw();
      calc();
    }));
  }

  function calc(){
    const out=document.querySelector<HTMLElement>('#w-result')!;
    const resultLabel=document.querySelector<HTMLElement>('#w-result-label')!;
    const used=document.querySelector<HTMLElement>('#w-used')!;
    const left=document.querySelector<HTMLElement>('#w-left')!;
    const status=document.querySelector<HTMLElement>('#w-status')!;
    const contribution=document.querySelector<HTMLElement>('#w-contribution')!;
    const error=document.querySelector<HTMLElement>('#w-error')!;

    try{
      const parsed=items.map(([grade,weight])=>({grade:parseDecimal(grade),weight:parseDecimal(weight)}));
      const result=weightedAverage(parsed);
      out.textContent=formatNumber(roundHalfUp(result.average,2),2);
      used.textContent=`${formatNumber(result.totalWeight,1)}%`;
      left.textContent=`${formatNumber(Math.max(0,100-result.totalWeight),1)}%`;
      contribution.textContent=formatNumber(roundHalfUp(result.contribution,2),2);

      const state=weightStatus(result.totalWeight);
      if(state==='complete'){
        resultLabel.textContent='Promedio ponderado';
        status.textContent='Ponderación completa: los porcentajes suman aproximadamente 100%.';
        error.textContent='';
      } else if(state==='under'){
        resultLabel.textContent='Promedio del peso ingresado';
        status.textContent='Este promedio normaliza solo las evaluaciones ingresadas. El aporte sobre 100% muestra cuánto contribuyen al curso completo.';
        error.textContent='Aún falta porcentaje por completar.';
      } else {
        resultLabel.textContent='Promedio ponderado';
        status.textContent='';
        error.textContent='Revisa los porcentajes antes de usar este resultado.';
      }
    }catch(e){
      out.textContent='—';
      resultLabel.textContent='Promedio ponderado';
      used.textContent='—';
      left.textContent='—';
      contribution.textContent='—';
      status.textContent='';
      error.textContent=e instanceof Error?e.message:'Revisa los datos.';
    }
  }

  document.querySelector('#w-add')?.addEventListener('click',()=>{
    const error=document.querySelector<HTMLElement>('#w-error')!;
    if(items.length>=100){
      error.textContent='Puedes trabajar con hasta 100 evaluaciones por cálculo.';
      return;
    }
    items.push(['','']);
    draw();
  });
  document.querySelector('#w-form')?.addEventListener('submit',e=>{
    e.preventDefault();
    calc();
  });

  document.querySelector('#w-share')?.addEventListener('click',async()=>{
    if(items.length>30){
      shareStatus.textContent='Para compartir, reduce la lista a 30 evaluaciones o menos.';
      return;
    }
    const parsed=items.map(([grade,weight])=>({grade:parseDecimal(grade),weight:parseDecimal(weight)}));
    try{
      weightedAverage(parsed);
    }catch{
      shareStatus.textContent='Corrige las notas y porcentajes antes de compartir.';
      return;
    }
    const url=shareUrl();
    try{
      if(navigator.share){
        await navigator.share({title:'Notas con porcentaje',url});
        shareStatus.textContent='Cálculo compartido.';
      }else{
        await navigator.clipboard.writeText(url);
        shareStatus.textContent='Enlace copiado al portapapeles.';
      }
    }catch{
      shareStatus.textContent='No se pudo compartir. Puedes copiar la URL del navegador como alternativa.';
    }
  });

  document.querySelector('#w-reset')?.addEventListener('click',()=>{
    items=[['6,0','20'],['5,5','30'],['4,8','50']];
    shareStatus.textContent='';
    history.replaceState(null,'',window.location.pathname+window.location.search);
    draw();
    calc();
  });

  readHash();
  draw();
  calc();
</script>
