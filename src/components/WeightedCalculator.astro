---
import RoundingControls from './RoundingControls.astro';
import { formatNumber, roundHalfUp, weightedAverage } from '../lib/calculators/core';
const initialItems=[['6,0','20'],['5,5','30'],['4,8','50']];
const initialWeighted=weightedAverage([{grade:6,weight:20},{grade:5.5,weight:30},{grade:4.8,weight:50}]);
---
<div class="tool-shell">
  <div class="tool-head">
    <div>
      <h2>Calculadora de notas con porcentaje</h2>
      <p>Combina notas y ponderaciones para obtener tu promedio ponderado y ver cuánto peso falta.</p>
    </div>
    <span class="badge">Peso visible</span>
  </div>

  <div class="tool-grid">
    <form class="tool-panel" id="w-form">
      <div class="list-editor" id="w-list">
        {initialItems.map((row,index)=>
          <div class="row-editor">
            <div class="field" style="margin:0">
              <label for={`w-grade-${index}`}>Nota {index+1}</label>
              <input class="input w-grade" id={`w-grade-${index}`} data-i={index} value={row[0]} inputmode="decimal" />
            </div>
            <div class="field" style="margin:0">
              <label for={`w-weight-${index}`}>Peso (%)</label>
              <input class="input w-weight" id={`w-weight-${index}`} data-i={index} value={row[1]} inputmode="decimal" />
            </div>
            <button class="icon-btn" type="button" data-remove={index} aria-label={`Eliminar evaluación ${index+1}`} title="Eliminar evaluación">×</button>
          </div>
        )}
      </div>
      <RoundingControls prefix="w" decimals={2} />
      <div class="actions">
        <button class="btn btn-secondary" type="button" id="w-add">Agregar evaluación</button>
        <button class="btn btn-primary" type="submit">Calcular ponderación</button>
        <button class="btn btn-secondary" type="button" id="w-share">Compartir cálculo</button>
        <button class="btn btn-ghost" type="button" id="w-reset">Restablecer</button>
      </div>
    <p id="w-share-status" class="muted" aria-live="polite"></p>

    </form>

    <div class="tool-panel result-panel">
      <div class="result-card" aria-live="polite">
        <div class="result-label" id="w-result-label">Promedio ponderado</div>
        <div class="result-value" id="w-result">{formatNumber(roundHalfUp(initialWeighted.average,2),2)}</div>
        <p>Calculado (3 decimales): <strong id="w-exact">{formatNumber(initialWeighted.average,3)}</strong></p>
        <div class="result-meta result-meta-three">
          <div class="result-stat">
            <span class="result-stat-label">Peso utilizado</span>
            <strong id="w-used">{formatNumber(initialWeighted.totalWeight,1)}%</strong>
          </div>
          <div class="result-stat">
            <span class="result-stat-label">Peso restante</span>
            <strong id="w-left">{formatNumber(100-initialWeighted.totalWeight,1)}%</strong>
          </div>
          <div class="result-stat">
            <span class="result-stat-label">Aporte sobre 100%</span>
            <strong id="w-contribution">{formatNumber(roundHalfUp(initialWeighted.contribution,2),2)}</strong>
          </div>
        </div>
        <p id="w-status" style="margin:16px 0 0;color:#b9c5d9;font-size:.88rem">Ponderación completa: los porcentajes suman aproximadamente 100%.</p>
      </div>
      <p id="w-error" class="muted" aria-live="polite"></p>
    </div>
  </div>
  <div class="tool-panel">
      <div class="saved-box">
        <div class="field">
          <label for="w-subject">Guardar como materia</label>
          <input class="input" id="w-subject" placeholder="Ej. Matemáticas" maxlength="80" />
          <small>Tus datos se guardan únicamente en este dispositivo.</small>
        </div>
        <div class="actions">
          <button class="btn btn-secondary" id="w-save" type="button">Guardar materia</button>
          <button class="btn btn-ghost" id="w-clear-all" type="button">Borrar guardadas</button>
        </div>
        <p id="w-storage-status" class="muted" aria-live="polite"></p>
        <div id="w-saved" class="saved-items" aria-live="polite"></div>
      </div>
  </div>
</div>

<script>
  import type { RoundingRule } from '../lib/calculators/core';
  import { shareOrCopy } from '../lib/browser/share';
  import { formatNumber, parseDecimal, roundGrade, roundHalfUp, weightedAverage, weightStatus } from '../lib/calculators/core';

  import { parseSavedSubjects, upsertSavedSubject } from '../lib/storage/savedSubjects';

  const list=document.querySelector<HTMLElement>('#w-list')!;
  const shareStatus=document.querySelector<HTMLElement>('#w-share-status')!;
  let items=[['6,0','20'],['5,5','30'],['4,8','50']];

  function readHash(){
    const params=new URLSearchParams(window.location.hash.replace(/^#/,''));
    for(const key of ['decimals','rounding']){
      const value=params.get(key);
      const input=document.querySelector<HTMLSelectElement>(`#w-${key}`)!;
      if(value!==null && Array.from(input.options).some(option=>option.value===value)) input.value=value;
    }
    const raw=params.get('ponderaciones');
    if(!raw) return;
    const parsed=raw.split('|').slice(0,30).map(pair=>{
      const [grade,weight]=pair.split(':');
      return [grade?.trim()||'',weight?.trim()||''];
    }).filter(([grade,weight])=>grade || weight);
    if(parsed.length) items=parsed;
  }

  function shareUrl(){
    const value=items.map(([grade,weight])=>`${grade.trim()}:${weight.trim()}`).join('|');
    const params=new URLSearchParams({ponderaciones:value});
    params.set('decimals',(document.querySelector<HTMLSelectElement>('#w-decimals')!).value);
    params.set('rounding',(document.querySelector<HTMLSelectElement>('#w-rounding')!).value);
    return `${window.location.origin}${window.location.pathname}#${params.toString()}`;
  }

  function escapeHTML(value: unknown){
    return String(value)
      .replace(/&/g,'&amp;')
      .replace(/</g,'&lt;')
      .replace(/>/g,'&gt;')
      .replace(/"/g,'&quot;')
      .replace(/'/g,'&#039;');
  }

  function draw(){
    list.innerHTML=items.map((row,i)=>`
      <div class="row-editor">
        <div class="field" style="margin:0">
          <label for="w-grade-${i}">Nota ${i+1}</label>
          <input class="input w-grade" id="w-grade-${i}" data-i="${i}" value="${escapeHTML(row[0])}" inputmode="decimal">
        </div>
        <div class="field" style="margin:0">
          <label for="w-weight-${i}">Peso (%)</label>
          <input class="input w-weight" id="w-weight-${i}" data-i="${i}" value="${escapeHTML(row[1])}" inputmode="decimal">
        </div>
        <button class="icon-btn" type="button" data-remove="${i}" aria-label="Eliminar evaluación ${i+1}" title="Eliminar evaluación">×</button>
      </div>`).join('');

    list.querySelectorAll<HTMLInputElement>('.w-grade').forEach(input=>input.addEventListener('input',()=>{
      items[Number(input.dataset.i)][0]=input.value;
      calc();
    }));
    list.querySelectorAll<HTMLInputElement>('.w-weight').forEach(input=>input.addEventListener('input',()=>{
      items[Number(input.dataset.i)][1]=input.value;
      calc();
    }));
    list.querySelectorAll<HTMLButtonElement>('[data-remove]').forEach(button=>button.addEventListener('click',()=>{
      items.splice(Number(button.dataset.remove),1);
      if(!items.length) items=[['','']];
      draw();
      calc();
    }));
  }

  function calc(){
    const out=document.querySelector<HTMLElement>('#w-result')!;
    const resultLabel=document.querySelector<HTMLElement>('#w-result-label')!;
    const used=document.querySelector<HTMLElement>('#w-used')!;
    const left=document.querySelector<HTMLElement>('#w-left')!;
    const status=document.querySelector<HTMLElement>('#w-status')!;
    const contribution=document.querySelector<HTMLElement>('#w-contribution')!;
    const error=document.querySelector<HTMLElement>('#w-error')!;

    try{
      const parsed=items.map(([grade,weight])=>({grade:parseDecimal(grade),weight:parseDecimal(weight)}));
      const result=weightedAverage(parsed);
      const decimals=Number((document.querySelector<HTMLSelectElement>('#w-decimals')!).value);
      const rounding=(document.querySelector<HTMLSelectElement>('#w-rounding')!).value as RoundingRule;
      out.textContent=formatNumber(roundGrade(result.average,decimals,rounding),decimals);
      (document.querySelector<HTMLElement>('#w-exact')!).textContent=formatNumber(result.average,3);
      used.textContent=`${formatNumber(result.totalWeight,1)}%`;
      left.textContent=`${formatNumber(Math.max(0,100-result.totalWeight),1)}%`;
      contribution.textContent=formatNumber(roundHalfUp(result.contribution,2),2);

      const state=weightStatus(result.totalWeight);
      if(state==='complete'){
        resultLabel.textContent='Promedio ponderado';
        status.textContent='Ponderación completa: los porcentajes suman aproximadamente 100%.';
        error.textContent='';
      } else if(state==='under'){
        resultLabel.textContent='Promedio del peso ingresado';
        status.textContent='Este promedio normaliza solo las evaluaciones ingresadas. El aporte sobre 100% muestra cuánto contribuyen al curso completo.';
        error.textContent='Aún falta porcentaje por completar.';
      } else {
        resultLabel.textContent='Promedio ponderado';
        status.textContent='';
        error.textContent='Revisa los porcentajes antes de usar este resultado.';
      }
    }catch(e){
      out.textContent='—';
      (document.querySelector<HTMLElement>('#w-exact')!).textContent='—';
      resultLabel.textContent='Promedio ponderado';
      used.textContent='—';
      left.textContent='—';
      contribution.textContent='—';
      status.textContent='';
      error.textContent=e instanceof Error?e.message:'Revisa los datos.';
    }
  }

  const storageKey='notacl.saved.weighted.subjects';
  const storageStatus=document.querySelector<HTMLElement>('#w-storage-status')!;

  function saved(){
    try{
      return parseSavedSubjects(localStorage.getItem(storageKey)).filter(row=>row.weights);
    }catch{
      storageStatus.textContent='El almacenamiento local no está disponible en este navegador.';
      return [];
    }
  }

  function persist(rows: ReturnType<typeof parseSavedSubjects>){
    try{
      localStorage.setItem(storageKey,JSON.stringify(rows));
      storageStatus.textContent='Guardado en este dispositivo.';
      return true;
    }catch{
      storageStatus.textContent='No se pudo guardar en este dispositivo. El cálculo sigue funcionando normalmente.';
      return false;
    }
  }

  function renderSaved(){
    const box=document.querySelector<HTMLElement>('#w-saved')!;
    const rows=saved();
    box.innerHTML=rows.length?rows.map((row,i)=>`
      <div class="saved-item">
        <span><strong>${escapeHTML(row.subject)}</strong><small>${formatNumber(row.average,2)} · ${row.values.length} evaluaciones · ${escapeHTML(new Date(row.updatedAt).toLocaleDateString('es-CL'))}</small></span>
        <span class="saved-actions">
          <button class="btn btn-ghost" data-load="${i}" type="button">Cargar</button>
          <button class="btn btn-ghost" data-delete="${i}" type="button">Borrar</button>
        </span>
      </div>`).join(''):'<p class="muted">Aún no tienes materias ponderadas guardadas.</p>';
    box.querySelectorAll<HTMLButtonElement>('[data-load]').forEach(button=>button.addEventListener('click',()=>{
      const row=saved()[Number(button.dataset.load)];
      if(!row?.weights) return;
      items=row.values.map((value,i)=>[value,row.weights![i]]);
      (document.querySelector<HTMLInputElement>('#w-subject')!).value=row.subject;
      draw();
      calc();
    }));
    box.querySelectorAll<HTMLButtonElement>('[data-delete]').forEach(button=>button.addEventListener('click',()=>{
      const rows=saved();
      rows.splice(Number(button.dataset.delete),1);
      if(persist(rows)) renderSaved();
    }));
  }

  document.querySelector('#w-save')?.addEventListener('click',()=>{
    const subject=(document.querySelector<HTMLInputElement>('#w-subject')!).value.trim();
    if(!subject){
      storageStatus.textContent='Escribe un nombre para la materia antes de guardarla.';
      return;
    }
    try{
      const result=weightedAverage(items.map(([grade,weight])=>({grade:parseDecimal(grade),weight:parseDecimal(weight)})));
      const record={subject,average:result.average,values:items.map(row=>row[0]),weights:items.map(row=>row[1]),updatedAt:new Date().toISOString()};
      if(persist(upsertSavedSubject(saved(),record))) renderSaved();
    }catch{
      storageStatus.textContent='Corrige las notas y porcentajes antes de guardar la materia.';
    }
  });

  document.querySelector('#w-clear-all')?.addEventListener('click',()=>{
    if(!saved().length || !window.confirm('¿Borrar todas las materias ponderadas guardadas en este dispositivo?')) return;
    try{
      localStorage.removeItem(storageKey);
      storageStatus.textContent='Materias ponderadas eliminadas.';
      renderSaved();
    }catch{
      storageStatus.textContent='No se pudo modificar el almacenamiento local de este navegador.';
    }
  });

  document.querySelector('#w-add')?.addEventListener('click',()=>{
    const error=document.querySelector<HTMLElement>('#w-error')!;
    if(items.length>=100){
      error.textContent='Puedes trabajar con hasta 100 evaluaciones por cálculo.';
      return;
    }
    items.push(['','']);
    draw();
  });
  document.querySelector('#w-decimals')?.addEventListener('change',calc);
  document.querySelector('#w-rounding')?.addEventListener('change',calc);
  document.querySelector('#w-form')?.addEventListener('submit',e=>{
    e.preventDefault();
    calc();
  });

  document.querySelector('#w-share')?.addEventListener('click',async()=>{
    if(items.length>30){
      shareStatus.textContent='Para compartir, reduce la lista a 30 evaluaciones o menos.';
      return;
    }
    const parsed=items.map(([grade,weight])=>({grade:parseDecimal(grade),weight:parseDecimal(weight)}));
    try{
      weightedAverage(parsed);
    }catch{
      shareStatus.textContent='Corrige las notas y porcentajes antes de compartir.';
      return;
    }
    const url=shareUrl();
    const shareResult=await shareOrCopy('Notas con porcentaje',url);
    if(shareResult==='shared') shareStatus.textContent='Cálculo compartido.';
    else if(shareResult==='copied') shareStatus.textContent='Enlace copiado al portapapeles.';
    else if(shareResult==='cancelled') shareStatus.textContent='';
    else shareStatus.textContent='No se pudo compartir. Puedes copiar la URL del navegador como alternativa.';
  });

  document.querySelector('#w-reset')?.addEventListener('click',()=>{
    (document.querySelector<HTMLSelectElement>('#w-decimals')!).value='2';
    (document.querySelector<HTMLSelectElement>('#w-rounding')!).value='half-up';
    items=[['6,0','20'],['5,5','30'],['4,8','50']];
    (document.querySelector<HTMLInputElement>('#w-subject')!).value='';
    shareStatus.textContent='';
    history.replaceState(null,'',window.location.pathname+window.location.search);
    draw();
    calc();
  });

  readHash();
  draw();
  calc();
  renderSaved();
</script>
