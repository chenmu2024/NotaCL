<div class="tool-shell">
  <div class="tool-head"><div><h2>Calculadora de notas con porcentaje</h2><p>Combina notas y ponderaciones para obtener tu promedio ponderado.</p></div><span class="badge">Peso visible</span></div>
  <div class="tool-grid">
    <form class="tool-panel" id="w-form"><div class="list-editor" id="w-list"></div><div class="actions"><button class="btn btn-secondary" type="button" id="w-add">Agregar evaluación</button><button class="btn btn-primary" type="submit">Calcular</button></div></form>
    <div class="tool-panel"><div class="result-card" aria-live="polite"><div class="result-label">Promedio ponderado</div><div class="result-value" id="w-result">—</div><div class="result-meta"><span id="w-used">Peso utilizado: —</span><span id="w-left">Peso restante: —</span></div></div><p id="w-error" class="muted"></p></div>
  </div>
</div>
<script>
  import { formatNumber, parseDecimal, roundHalfUp, weightedAverage, weightStatus } from '../lib/calculators/core';
  const list=document.querySelector<HTMLElement>('#w-list')!;let items=[['6,0','20'],['5,5','30'],['4,8','50']];
  function draw(){list.innerHTML=items.map((r,i)=>`<div class="row-editor"><div class="field" style="margin:0"><label>Nota ${i+1}</label><input class="input w-grade" data-i="${i}" value="${r[0]}" inputmode="decimal"></div><div class="field" style="margin:0"><label>Peso (%)</label><input class="input w-weight" data-i="${i}" value="${r[1]}" inputmode="decimal"></div><button class="icon-btn" type="button" data-remove="${i}">Eliminar</button></div>`).join('');list.querySelectorAll<HTMLInputElement>('.w-grade').forEach(e=>e.addEventListener('input',()=>{items[Number(e.dataset.i)][0]=e.value;calc()}));list.querySelectorAll<HTMLInputElement>('.w-weight').forEach(e=>e.addEventListener('input',()=>{items[Number(e.dataset.i)][1]=e.value;calc()}));list.querySelectorAll<HTMLButtonElement>('[data-remove]').forEach(b=>b.addEventListener('click',()=>{items.splice(Number(b.dataset.remove),1);if(!items.length)items=[['','']];draw();calc()}));}
  function calc(){const out=document.querySelector<HTMLElement>('#w-result')!,used=document.querySelector<HTMLElement>('#w-used')!,left=document.querySelector<HTMLElement>('#w-left')!,error=document.querySelector<HTMLElement>('#w-error')!;try{const parsed=items.map(([g,w])=>({grade:parseDecimal(g),weight:parseDecimal(w)}));const r=weightedAverage(parsed);out.textContent=formatNumber(roundHalfUp(r.average,2),2);used.textContent=`Peso utilizado: ${formatNumber(r.totalWeight,1)}%`;left.textContent=`Peso restante: ${formatNumber(Math.max(0,100-r.totalWeight),1)}%`;const s=weightStatus(r.totalWeight);error.textContent=s==='over'?'La suma supera 100%. Revisa las ponderaciones.':s==='under'?'El cálculo usa solo el porcentaje ingresado; aún falta peso por completar.':'';}catch(e){out.textContent='—';used.textContent='Peso utilizado: —';left.textContent='Peso restante: —';error.textContent=e instanceof Error?e.message:'Revisa los datos.'}}
  document.querySelector('#w-add')?.addEventListener('click',()=>{items.push(['','']);draw()});document.querySelector('#w-form')?.addEventListener('submit',e=>{e.preventDefault();calc()});draw();calc();
</script>
