<div class="tool-shell quick-tool" id="calculadora">
  <div class="tool-head">
    <div>
      <h2>Calculadora rápida de nota</h2>
      <p>Ingresa tu puntaje, el máximo y la exigencia para obtener el resultado al instante.</p>
    </div>
    <span class="badge">Escala configurable</span>
  </div>
  <div class="tool-grid">
    <form class="tool-panel" id="quick-form">
      <div class="field">
        <label for="q-score">Puntaje obtenido</label>
        <input class="input" id="q-score" inputmode="decimal" value="42" />
      </div>
      <div class="field">
        <label for="q-max">Puntaje máximo</label>
        <input class="input" id="q-max" inputmode="decimal" value="60" />
      </div>
      <div class="field">
        <label for="q-exigency">Exigencia (%)</label>
        <input class="input" id="q-exigency" inputmode="decimal" value="60" />
        <small>Debe ser mayor que 0 y menor que 100.</small>
      </div>
      <div class="actions">
        <button class="btn btn-primary" type="submit">Calcular nota</button>
        <button class="btn btn-secondary" type="button" id="q-share">Compartir cálculo</button>
        <button class="btn btn-ghost" type="button" id="q-reset">Restablecer</button>
        <a class="btn btn-ghost" href="#tabla">Ver tabla completa</a>
      </div>
      <p id="q-share-status" class="muted" aria-live="polite"></p>
      <p class="notice warning">El 60% y la escala 1,0–7,0 son valores iniciales. Ajusta la exigencia si tu evaluación usa otra regla.</p>
    </form>
    <div class="tool-panel result-panel">
      <div class="result-card" aria-live="polite">
        <div class="result-label">Resultado instantáneo</div>
        <div class="result-value" id="q-result">—</div>
        <div class="result-meta">
          <div class="result-stat">
            <span class="result-stat-label">Porcentaje</span>
            <strong id="q-percent">—</strong>
          </div>
          <div class="result-stat">
            <span class="result-stat-label">Estado</span>
            <span id="q-status" class="status">—</span>
          </div>
        </div>
        <p id="q-error" style="margin:16px 0 0;color:#b9c5d9;font-size:.86rem"></p>
      </div>
    </div>
  </div>
</div>
<script>
  import { DEFAULT_GRADE_CONFIG, formatNumber, parseDecimal, scoreToGrade } from '../lib/calculators/core';
  const form = document.querySelector<HTMLFormElement>('#quick-form')!;
  const result = document.querySelector<HTMLElement>('#q-result')!;
  const percent = document.querySelector<HTMLElement>('#q-percent')!;
  const status = document.querySelector<HTMLElement>('#q-status')!;
  const error = document.querySelector<HTMLElement>('#q-error')!;
  const shareStatus = document.querySelector<HTMLElement>('#q-share-status')!;

  function readHash(){
    const raw=window.location.hash.replace(/^#/,'');
    if(!raw) return;
    const params=new URLSearchParams(raw);
    const score=params.get('score');
    const max=params.get('max');
    const exigencia=params.get('exigencia');
    if(score) (document.querySelector<HTMLInputElement>('#q-score')!).value=score;
    if(max) (document.querySelector<HTMLInputElement>('#q-max')!).value=max;
    if(exigencia) (document.querySelector<HTMLInputElement>('#q-exigency')!).value=exigencia;
  }

  function shareUrl(){
    const params=new URLSearchParams({
      score:(document.querySelector<HTMLInputElement>('#q-score')!).value.trim(),
      max:(document.querySelector<HTMLInputElement>('#q-max')!).value.trim(),
      exigencia:(document.querySelector<HTMLInputElement>('#q-exigency')!).value.trim(),
    });
    return `${window.location.origin}${window.location.pathname}#${params.toString()}`;
  }
  function run(){
    try {
      const score=parseDecimal((document.querySelector<HTMLInputElement>('#q-score')!).value);
      const max=parseDecimal((document.querySelector<HTMLInputElement>('#q-max')!).value);
      const exig=parseDecimal((document.querySelector<HTMLInputElement>('#q-exigency')!).value)/100;
      const cfg={...DEFAULT_GRADE_CONFIG,exigency:exig};
      const grade=scoreToGrade(score,max,cfg);
      result.textContent=formatNumber(grade,1);
      percent.textContent=`${formatNumber((score/max)*100,1)}%`;
      const passed=grade>=cfg.passGrade;
      status.textContent=passed?'Aprobado':'Reprobado';
      status.className=`status ${passed?'good':'bad'}`;
      error.textContent='';
    } catch(e){
      result.textContent='—';
      percent.textContent='—';
      status.textContent='—';
      status.className='status';
      error.textContent=e instanceof Error?e.message:'Revisa los valores.';
    }
  }
  form.addEventListener('submit',(e)=>{e.preventDefault();run()});
  form.addEventListener('input',run);

  document.querySelector('#q-reset')?.addEventListener('click',()=>{
    (document.querySelector<HTMLInputElement>('#q-score')!).value='42';
    (document.querySelector<HTMLInputElement>('#q-max')!).value='60';
    (document.querySelector<HTMLInputElement>('#q-exigency')!).value='60';
    history.replaceState(null,'',window.location.pathname);
    shareStatus.textContent='';
    run();
  });

  document.querySelector('#q-share')?.addEventListener('click',async()=>{
    const url=shareUrl();
    try{
      if(navigator.share){
        await navigator.share({title:'Escala de notas',url});
        shareStatus.textContent='Cálculo compartido.';
      }else{
        await navigator.clipboard.writeText(url);
        shareStatus.textContent='Enlace copiado al portapapeles.';
      }
    }catch{
      shareStatus.textContent='No se pudo compartir el enlace.';
    }
  });

  readHash();
  run();
</script>
