<div class="tool-shell">
  <div class="tool-head">
    <div>
      <h2>Calcula tu promedio</h2>
      <p>Agrega o elimina notas. Conservamos el resultado exacto y mostramos el redondeo por separado.</p>
    </div>
    <span class="badge">Guardado local opcional</span>
  </div>

  <div class="tool-grid">
    <form class="tool-panel" id="avg-form">
      <div class="list-editor" id="avg-list"></div>
      <div class="actions">
        <button class="btn btn-secondary" type="button" id="avg-add">Agregar nota</button>
        <button class="btn btn-primary" type="submit">Calcular promedio</button>
        <button class="btn btn-ghost" type="button" id="avg-reset">Restablecer</button>
      </div>

      <div class="saved-box">
        <div class="field">
          <label for="avg-subject">Guardar como materia</label>
          <input class="input" id="avg-subject" placeholder="Ej. Matemáticas" />
          <small>Se guarda únicamente en este dispositivo.</small>
        </div>
        <div class="actions">
          <button class="btn btn-secondary" id="avg-save" type="button">Guardar materia</button>
          <button class="btn btn-ghost" id="avg-clear-all" type="button">Borrar guardadas</button>
        </div>
        <div id="avg-saved" class="saved-items" aria-live="polite"></div>
      </div>
    </form>

    <div class="tool-panel result-panel">
      <div class="result-card" aria-live="polite">
        <div class="result-label">Promedio</div>
        <div class="result-value" id="avg-result">—</div>
        <div class="result-meta">
          <div class="result-stat">
            <span class="result-stat-label">Exacto</span>
            <strong id="avg-exact">—</strong>
          </div>
          <div class="result-stat">
            <span class="result-stat-label">Rango</span>
            <strong id="avg-range">—</strong>
          </div>
        </div>
        <p id="avg-error" style="margin:16px 0 0;color:#b9c5d9;font-size:.88rem"></p>
      </div>
    </div>
  </div>
</div>

<script>
  import { average, formatNumber, parseDecimal, roundHalfUp } from '../lib/calculators/core';
  import { parseSavedSubjects, upsertSavedSubject } from '../lib/storage/savedSubjects';

  const list=document.querySelector<HTMLElement>('#avg-list')!;
  const result=document.querySelector<HTMLElement>('#avg-result')!;
  const exact=document.querySelector<HTMLElement>('#avg-exact')!;
  const range=document.querySelector<HTMLElement>('#avg-range')!;
  const err=document.querySelector<HTMLElement>('#avg-error')!;
  const key='notacl.saved.subjects';
  let values=['5,5','6,2','4,8','6,0'];

  function escapeHTML(value: unknown){
    return String(value)
      .replace(/&/g,'&amp;')
      .replace(/</g,'&lt;')
      .replace(/>/g,'&gt;')
      .replace(/"/g,'&quot;')
      .replace(/'/g,'&#039;');
  }

  function renderRows(){
    list.innerHTML=values.map((v,i)=>`
      <div class="row-editor simple">
        <div class="field" style="margin:0">
          <label for="avg-${i}">Nota ${i+1}</label>
          <input class="input avg-input" id="avg-${i}" data-i="${i}" value="${escapeHTML(v)}" inputmode="decimal" aria-label="Nota ${i+1}">
        </div>
        <button class="icon-btn" type="button" data-remove="${i}" aria-label="Eliminar nota ${i+1}" title="Eliminar nota">×</button>
      </div>`).join('');

    list.querySelectorAll<HTMLInputElement>('.avg-input').forEach(el=>el.addEventListener('input',()=>{
      values[Number(el.dataset.i)]=el.value;
      calc();
    }));

    list.querySelectorAll<HTMLButtonElement>('[data-remove]').forEach(button=>button.addEventListener('click',()=>{
      values.splice(Number(button.dataset.remove),1);
      if(!values.length) values=[''];
      renderRows();
      calc();
    }));
  }

  function calc(){
    try{
      const nums=values.map(parseDecimal);
      const a=average(nums);
      result.textContent=formatNumber(roundHalfUp(a,1),1);
      exact.textContent=formatNumber(a,3);
      range.textContent=`${formatNumber(Math.min(...nums),1)} – ${formatNumber(Math.max(...nums),1)}`;
      err.textContent='';
      return a;
    }catch(e){
      result.textContent='—';
      exact.textContent='—';
      range.textContent='—';
      err.textContent=e instanceof Error?e.message:'Revisa las notas.';
      return null;
    }
  }

  function saved(){
    return parseSavedSubjects(localStorage.getItem(key));
  }

  function persist(rows: ReturnType<typeof parseSavedSubjects>){
    localStorage.setItem(key,JSON.stringify(rows));
  }

  function renderSaved(){
    const box=document.querySelector<HTMLElement>('#avg-saved')!;
    const rows=saved();
    if(!rows.length){
      box.innerHTML='<p class="muted" style="margin:8px 0 0">Aún no tienes materias guardadas.</p>';
      return;
    }

    box.innerHTML=rows.map((row:any,i:number)=>`
      <div class="saved-item">
        <span><strong>${escapeHTML(row.subject)}</strong><small>${formatNumber(row.average,1)} · ${Array.isArray(row.values)?row.values.length:0} notas</small></span>
        <span class="saved-actions">
          <button class="btn btn-ghost" data-load="${i}" type="button">Cargar</button>
          <button class="btn btn-ghost" data-delete="${i}" type="button">Borrar</button>
        </span>
      </div>`).join('');

    box.querySelectorAll<HTMLButtonElement>('[data-load]').forEach(button=>button.addEventListener('click',()=>{
      const row=saved()[Number(button.dataset.load)];
      if(!row || !Array.isArray(row.values)) return;
      values=row.values.map(String);
      (document.querySelector<HTMLInputElement>('#avg-subject')!).value=row.subject||'';
      renderRows();
      calc();
    }));

    box.querySelectorAll<HTMLButtonElement>('[data-delete]').forEach(button=>button.addEventListener('click',()=>{
      const rows=saved();
      rows.splice(Number(button.dataset.delete),1);
      persist(rows);
      renderSaved();
    }));
  }

  document.querySelector('#avg-add')?.addEventListener('click',()=>{
    values.push('');
    renderRows();
  });

  document.querySelector('#avg-form')?.addEventListener('submit',e=>{
    e.preventDefault();
    calc();
  });

  document.querySelector('#avg-save')?.addEventListener('click',()=>{
    const subject=(document.querySelector<HTMLInputElement>('#avg-subject')!).value.trim();
    const a=calc();
    if(!subject || a===null) return;

    const rows=saved();
    const record={subject,average:a,values:[...values],updatedAt:new Date().toISOString()};
    persist(upsertSavedSubject(rows,record));
    renderSaved();
  });

  document.querySelector('#avg-reset')?.addEventListener('click',()=>{
    values=['5,5','6,2','4,8','6,0'];
    (document.querySelector<HTMLInputElement>('#avg-subject')!).value='';
    renderRows();
    calc();
  });

  document.querySelector('#avg-clear-all')?.addEventListener('click',()=>{
    if(!saved().length) return;
    if(!window.confirm('¿Borrar todas las materias guardadas en este dispositivo?')) return;
    localStorage.removeItem(key);
    renderSaved();
  });

  renderRows();
  calc();
  renderSaved();
</script>
