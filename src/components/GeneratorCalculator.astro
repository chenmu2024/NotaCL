---
import RoundingControls from './RoundingControls.astro';
import { DEFAULT_GRADE_CONFIG, buildGradeScale, formatNumber } from '../lib/calculators/core';

interface Props {
  initialExigency?: number;
  lockExigency?: boolean;
}
const { initialExigency = 60, lockExigency = false } = Astro.props;
const initialMaxScore=60;
const initialConfig={...DEFAULT_GRADE_CONFIG,exigency:initialExigency/100};
const initialRows=buildGradeScale(initialMaxScore,initialConfig);
const initialFirstPassing=initialRows.filter(row=>row.passed).at(-1)?.score;
const initialThreshold=initialMaxScore*initialConfig.exigency;
---
<div class="tool-shell" id="generador" data-initial-exigency={initialExigency}>
  <div class="tool-head">
    <div>
      <h2>Genera tu tabla de notas</h2>
      <p>Ajusta los parámetros y crea una escala completa de puntaje a nota.</p>
    </div>
    <span class="badge">Sin registro</span>
  </div>

  <div class="tool-panel">
    <form id="gen-form" class="no-print">
      {!lockExigency && <div class="preset-row" aria-label="Exigencias rápidas">
        <span>Exigencia rápida</span>
        <button type="button" class:list={['preset-chip', initialExigency === 50 && 'active']} data-exigency="50">50%</button>
        <button type="button" class:list={['preset-chip', initialExigency === 60 && 'active']} data-exigency="60">60%</button>
        <button type="button" class:list={['preset-chip', initialExigency === 70 && 'active']} data-exigency="70">70%</button>
      </div>}

      <div class="inline-fields">
        <div class="field">
          <label for="g-maxscore">Puntaje máximo</label>
          <input class="input" id="g-maxscore" value="60" inputmode="numeric" />
        </div>
        <div class="field">
          <label for="g-exigency">Exigencia (%)</label>
          <input class="input" id="g-exigency" value={String(initialExigency)} inputmode="decimal" readonly={lockExigency} />
          {lockExigency && <small>Fijada en {initialExigency}% para esta escala.</small>}
        </div>
        <div class="field">
          <label for="g-min">Nota mínima</label>
          <input class="input" id="g-min" value="1,0" inputmode="decimal" />
        </div>
        <div class="field">
          <label for="g-pass">Nota de aprobación</label>
          <input class="input" id="g-pass" value="4,0" inputmode="decimal" />
        </div>
        <div class="field">
          <label for="g-maxgrade">Nota máxima</label>
          <input class="input" id="g-maxgrade" value="7,0" inputmode="decimal" />
        </div>
      </div>

      <RoundingControls prefix="g" />
      <div class="generator-summary" aria-live="polite">
        <div><span>Corte teórico</span><strong id="g-threshold">{formatNumber(initialThreshold,1)} pts</strong></div>
        <div><span>Primer puntaje entero que cumple exigencia</span><strong id="g-count">{initialFirstPassing ?? '—'}{initialFirstPassing !== undefined ? ' pts' : ''}</strong></div>
        <div><span>Escala</span><strong id="g-range">{formatNumber(initialConfig.minGrade,1)}–{formatNumber(initialConfig.maxGrade,1)}</strong></div>
      </div>
      <p class="muted generator-status-note">El estado compara el resultado exacto con la nota de aprobación, antes del redondeo visual. Así, un 3,95 que se muestre como 4,0 no se marca automáticamente como aprobado. Verifica la regla de tu establecimiento si estás justo en el límite.</p>

      <div class="actions">
        <button class="btn btn-primary" type="submit">Generar tabla</button>
        <button class="btn btn-secondary" type="button" id="g-print">Imprimir / Guardar PDF</button>
        <button class="btn btn-secondary" type="button" id="g-download">Descargar CSV</button>
        <button class="btn btn-secondary" type="button" id="g-share">Compartir configuración</button>
        <button class="btn btn-ghost" type="button" id="g-copy">Copiar CSV</button>
        <button class="btn btn-ghost" type="button" id="g-reset">Restablecer</button>
      </div>
      <p id="g-action-status" class="muted" aria-live="polite"></p>
      <p id="g-error" class="notice error" aria-live="polite" hidden></p>
    </form>
  </div>

  <div class="tool-panel">
    <div class="print-only print-summary">
      <h2>Escala de notas</h2>
      <p><strong>Puntaje máximo:</strong> <span id="g-print-max">{formatNumber(initialMaxScore,0)}</span> · <strong>Exigencia:</strong> <span id="g-print-exigency">{formatNumber(initialConfig.exigency*100,1)}%</span> · <strong>Escala:</strong> <span id="g-print-scale">{formatNumber(initialConfig.minGrade,1)}–{formatNumber(initialConfig.maxGrade,1)}</span></p>
      <p id="g-print-rounding">1 decimal · Mitad hacia arriba. El estado usa el valor sin redondear.</p>
    </div>
    <div class="table-wrap" tabindex="0" role="region" aria-label="Tabla con desplazamiento horizontal">
      <table class="data-table">
        <caption class="sr-only">Tabla de puntaje, porcentaje, nota calculada y estado según la configuración elegida.</caption>
        <thead><tr><th>Puntaje</th><th>Porcentaje</th><th>Nota</th><th>Estado según corte</th></tr></thead>
        <tbody id="g-body">
          {initialRows.map(row=>
            <tr>
              <td>{row.score}</td>
              <td>{formatNumber(row.percentage,1)}%</td>
              <td><strong>{formatNumber(row.grade,initialConfig.decimals)}</strong></td>
              <td class:list={['status',row.passed?'good':'bad']}>{row.passed?'Cumple exigencia':'Bajo exigencia'}</td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  import type { RoundingRule } from '../lib/calculators/core';
  import { shareOrCopy } from '../lib/browser/share';
  import { buildGradeScale, formatNumber, parseDecimal } from '../lib/calculators/core';

  const shell=document.querySelector<HTMLElement>('#generador')!;
  const initialExigencyValue=Number(shell.dataset.initialExigency||'60');
  const form=document.querySelector<HTMLFormElement>('#gen-form')!;
  const body=document.querySelector<HTMLElement>('#g-body')!;
  const error=document.querySelector<HTMLElement>('#g-error')!;
  const actionStatus=document.querySelector<HTMLElement>('#g-action-status')!;
  let currentRows: ReturnType<typeof buildGradeScale>=[];

  function config(){
    return {
      minGrade:parseDecimal((document.querySelector<HTMLInputElement>('#g-min')!).value),
      passGrade:parseDecimal((document.querySelector<HTMLInputElement>('#g-pass')!).value),
      maxGrade:parseDecimal((document.querySelector<HTMLInputElement>('#g-maxgrade')!).value),
      exigency:parseDecimal((document.querySelector<HTMLInputElement>('#g-exigency')!).value)/100,
      decimals:Number((document.querySelector<HTMLSelectElement>('#g-decimals')!).value),
      rounding:(document.querySelector<HTMLSelectElement>('#g-rounding')!).value as RoundingRule
    };
  }

  function readHash(){
    const params=new URLSearchParams(window.location.hash.replace(/^#/,''));
    const fields=[
      ['gmax','#g-maxscore'],
      ['gmin','#g-min'],
      ['gaprobacion','#g-pass'],
      ['gmaxnota','#g-maxgrade'],
      ['gdecimales','#g-decimals'],
      ['gredondeo','#g-rounding'],
    ];
    for(const [key,selector] of fields){
      const value=params.get(key)??(key==='gmax' && document.querySelector('#quick-form')?params.get('max'):null);
      const input=document.querySelector<HTMLInputElement|HTMLSelectElement>(selector);
      if(value!==null && input) input.value=value;
    }
    const exigency=params.get('gexigencia')??(document.querySelector('#quick-form')?params.get('exigencia'):null);
    const exigencyInput=document.querySelector<HTMLInputElement>('#g-exigency');
    if(exigency!==null && exigencyInput && !exigencyInput.readOnly) exigencyInput.value=exigency;
  }

  function shareUrl(){
    const params=new URLSearchParams({
      gmax:(document.querySelector<HTMLInputElement>('#g-maxscore')!).value.trim(),
      gexigencia:(document.querySelector<HTMLInputElement>('#g-exigency')!).value.trim(),
      gmin:(document.querySelector<HTMLInputElement>('#g-min')!).value.trim(),
      gaprobacion:(document.querySelector<HTMLInputElement>('#g-pass')!).value.trim(),
      gmaxnota:(document.querySelector<HTMLInputElement>('#g-maxgrade')!).value.trim(),
      gdecimales:(document.querySelector<HTMLSelectElement>('#g-decimals')!).value,
      gredondeo:(document.querySelector<HTMLSelectElement>('#g-rounding')!).value,
    });
    const quickScore=document.querySelector<HTMLInputElement>('#q-score');
    if(quickScore) params.set('score',quickScore.value.trim());
    return `${window.location.origin}${window.location.pathname}#${params.toString()}`;
  }

  function csvText(){
    const cfg=config();
    return [
      'Puntaje;Porcentaje;Nota;Estado según corte',
      ...currentRows.map(row=>[
        row.score,
        `${formatNumber(row.percentage,1)}%`,
        formatNumber(row.grade,cfg.decimals),
        row.passed?'Cumple exigencia':'Bajo exigencia'
      ].join(';'))
    ].join('\n');
  }

  function render(){
    try{
      const max=parseDecimal((document.querySelector<HTMLInputElement>('#g-maxscore')!).value);
      const cfg=config();
      currentRows=buildGradeScale(max,cfg);

      body.innerHTML=currentRows.map(row=>`
        <tr>
          <td>${row.score}</td>
          <td>${formatNumber(row.percentage,1)}%</td>
          <td><strong>${formatNumber(row.grade,cfg.decimals)}</strong></td>
          <td class="status ${row.passed?'good':'bad'}">${row.passed?'Cumple exigencia':'Bajo exigencia'}</td>
        </tr>`).join('');

      const firstPassing=currentRows.filter(row=>row.passed).at(-1)?.score;
      (document.querySelector<HTMLElement>('#g-threshold')!).textContent=`${formatNumber(max*cfg.exigency,1)} pts`;
      (document.querySelector<HTMLElement>('#g-count')!).textContent=firstPassing===undefined?'—':`${firstPassing} pts`;
      (document.querySelector<HTMLElement>('#g-range')!).textContent=`${formatNumber(cfg.minGrade,1)}–${formatNumber(cfg.maxGrade,1)}`;
      (document.querySelector<HTMLElement>('#g-print-max')!).textContent=formatNumber(max,0);
      (document.querySelector<HTMLElement>('#g-print-exigency')!).textContent=`${formatNumber(cfg.exigency*100,1)}%`;
      (document.querySelector<HTMLElement>('#g-print-scale')!).textContent=`${formatNumber(cfg.minGrade,1)}–${formatNumber(cfg.maxGrade,1)}`;
      (document.querySelector<HTMLElement>('#g-print-rounding')!).textContent=`${cfg.decimals} decimales · ${cfg.rounding==='truncate'?'Truncado':'Mitad hacia arriba'}. El estado usa el valor sin redondear.`;
      error.hidden=true;
      actionStatus.textContent='';
    }catch(e){
      currentRows=[];
      body.innerHTML='';
      (document.querySelector<HTMLElement>('#g-threshold')!).textContent='—';
      (document.querySelector<HTMLElement>('#g-count')!).textContent='—';
      (document.querySelector<HTMLElement>('#g-range')!).textContent='—';
      error.textContent=e instanceof Error?e.message:'Revisa los valores.';
      error.hidden=false;
    }
    document.dispatchEvent(new Event('notacl:scale-updated'));
  }

  form.addEventListener('submit',event=>{event.preventDefault();render()});
  form.addEventListener('input',()=>{
    const value=(document.querySelector<HTMLInputElement>('#g-exigency')!).value;
    document.querySelectorAll<HTMLButtonElement>('[data-exigency]').forEach(button=>{
      button.classList.toggle('active',button.dataset.exigency===value);
    });
    render();
  });

  document.querySelectorAll<HTMLButtonElement>('[data-exigency]').forEach(button=>button.addEventListener('click',()=>{
    (document.querySelector<HTMLInputElement>('#g-exigency')!).value=button.dataset.exigency||'60';
    document.querySelectorAll<HTMLButtonElement>('[data-exigency]').forEach(item=>item.classList.toggle('active',item===button));
    render();
  }));

  document.querySelector('#g-print')?.addEventListener('click',()=>{
    if(!currentRows.length) return;
    document.body.classList.add('print-generator-only');
    window.print();
    document.body.classList.remove('print-generator-only');
  });
  window.addEventListener('afterprint',()=>document.body.classList.remove('print-generator-only'));

  document.querySelector('#g-share')?.addEventListener('click',async()=>{
    if(!currentRows.length) return;
    const url=shareUrl();
    const shareResult=await shareOrCopy('Configuración de escala de notas',url);
    if(shareResult==='shared') actionStatus.textContent='Configuración compartida.';
    else if(shareResult==='copied') actionStatus.textContent='Enlace de configuración copiado.';
    else if(shareResult==='cancelled') actionStatus.textContent='';
    else actionStatus.textContent='No se pudo compartir. Puedes copiar la URL del navegador como alternativa.';
  });

  document.querySelector('#g-copy')?.addEventListener('click',async()=>{
    if(!currentRows.length) return;
    try{
      await navigator.clipboard.writeText(csvText());
      actionStatus.textContent='CSV copiado al portapapeles.';
    }catch{
      actionStatus.textContent='No se pudo copiar automáticamente. Usa “Descargar CSV” como alternativa.';
    }
  });

  document.querySelector('#g-reset')?.addEventListener('click',()=>{
    (document.querySelector<HTMLInputElement>('#g-maxscore')!).value='60';
    (document.querySelector<HTMLInputElement>('#g-exigency')!).value=String(initialExigencyValue);
    (document.querySelector<HTMLInputElement>('#g-min')!).value='1,0';
    (document.querySelector<HTMLInputElement>('#g-pass')!).value='4,0';
    (document.querySelector<HTMLInputElement>('#g-maxgrade')!).value='7,0';
    (document.querySelector<HTMLSelectElement>('#g-decimals')!).value='1';
    (document.querySelector<HTMLSelectElement>('#g-rounding')!).value='half-up';
    document.querySelectorAll<HTMLButtonElement>('[data-exigency]').forEach(button=>{
      button.classList.toggle('active',button.dataset.exigency===String(initialExigencyValue));
    });
    actionStatus.textContent='';
    history.replaceState(null,'',window.location.pathname+window.location.search);
    render();
  });

  document.querySelector('#g-download')?.addEventListener('click',()=>{
    if(!currentRows.length) return;
    const blob=new Blob(['\ufeff',csvText()],{type:'text/csv;charset=utf-8'});
    const url=URL.createObjectURL(blob);
    const anchor=document.createElement('a');
    anchor.href=url;
    anchor.download='escala-de-notas.csv';
    anchor.click();
    URL.revokeObjectURL(url);
    actionStatus.textContent='CSV descargado.';
  });

  window.addEventListener('hashchange',()=>{readHash();render()});

  readHash();
  render();
</script>
