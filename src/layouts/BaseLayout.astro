---
import '../styles/global.css';
import { INDEXING_ENABLED, SITE_NAME, SITE_URL, navItems } from '../config/site';

interface Props {
  title: string;
  description: string;
  path?: string;
  type?: 'website' | 'article';
  schema?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description, path='/', type='website', schema=[] } = Astro.props;
const canonical = SITE_URL ? new URL(path, SITE_URL).toString() : undefined;
const schemas = Array.isArray(schema) ? schema : [schema];
const baseSchema = [
  {
    '@context':'https://schema.org', '@type':'WebSite', name:SITE_NAME,
    ...(SITE_URL ? {url:SITE_URL} : {}), inLanguage:'es-CL'
  },
  {
    '@context':'https://schema.org', '@type':'Organization', name:SITE_NAME,
    ...(SITE_URL ? {'@id':`${SITE_URL}#organization`, url:SITE_URL} : {})
  }
];
---
<!doctype html>
<html lang="es-CL">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={INDEXING_ENABLED ? 'index,follow,max-image-preview:large' : 'noindex,nofollow'} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content={type} />
  <meta property="og:locale" content="es_CL" />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta name="twitter:card" content="summary" />
  <meta name="theme-color" content="#3157d5" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="manifest" href="/site.webmanifest" />
  {[...baseSchema, ...schemas].map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/" aria-label={`${SITE_NAME}, inicio`}>Nota<span>CL</span></a>
      <nav class="nav" aria-label="Herramientas principales">
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </div>
  </header>
  <main><slot /></main>
  <footer class="site-footer">
    <div class="container footer-grid">
      <div>
        <a class="brand" href="/">Nota<span>CL</span></a>
        <p class="muted">Herramientas gratuitas para calcular notas, escalas, promedios y ponderaciones. Los parámetros pueden variar según cada establecimiento.</p>
      </div>
      <div class="footer-links"><strong>Herramientas</strong>{navItems.slice(0,4).map((item)=><a href={item.href}>{item.label}</a>)}</div>
      <div class="footer-links"><strong>Información</strong><a href="/sobre-nosotros/">Sobre nosotros</a><a href="/contacto/">Contacto</a><a href="/politica-de-privacidad/">Privacidad</a><a href="/terminos/">Términos</a><a href="/cookies/">Cookies</a></div>
    </div>
  </footer>
</body>
</html>
